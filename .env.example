# Fazle Core environment template
# Last reviewed: 2026-10-02
# Copy to .env and replace every placeholder locally or on the VPS.
# NEVER commit .env, production credentials, tokens, passwords, or WhatsApp stores.
# Admin username/password are database-backed; they are not environment variables.

# ── Required core services ───────────────────────────────────────────────────
DATABASE_URL=postgresql://fazle:replace-with-local-password@127.0.0.1:5432/fazle_dev
REDIS_URL=redis://127.0.0.1:6379/9
APP_PORT=8200
LOG_LEVEL=INFO
DEBUG=false
COMPANY_NAME=Al-Rifa'i Integrated Services
INTERNAL_API_KEY=replace-with-a-random-local-only-key

# Read-only HTTPS contract consumed by the Vessel Register Site's /api/core
# proxy. Keep blank until configured privately on the Core host and Site.
FAZLE_CORE_READ_KEY=
VESSEL_REGISTER_CONTEXT_ENABLED=true
VESSEL_REGISTER_CONTEXT_TIMEOUT_SECONDS=1.5

# ── AI runtimes and providers ────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:3b
OLLAMA_RUNTIME_MODEL=hermes3:3b
OLLAMA_BUSINESS_MODEL=hermes3:3b
OLLAMA_MEMORY_MODEL=hermes3:3b
OLLAMA_GENERAL_MODEL=hermes3:3b
OLLAMA_DEEP_REASONING_MODEL=hermes3:3b
OLLAMA_REPLY_DISABLED=false
OLLAMA_INFER_CONCURRENCY=1
OLLAMA_CHAT_CONCURRENCY=1
OLLAMA_HTTP_MAX_CONNECTIONS=16
OLLAMA_HTTP_MAX_KEEPALIVE_CONNECTIONS=8
OLLAMA_NUM_CTX_DEFAULT=512
OLLAMA_NUM_CTX_CLASSIFY=256
OLLAMA_NUM_PREDICT_REPLY=50
OLLAMA_NUM_PREDICT_RECRUITMENT=50
OLLAMA_NUM_PREDICT_CHAT=100
OLLAMA_NUM_PREDICT_RAG=150
OLLAMA_TEMPERATURE_REPLY=0.4
OLLAMA_TEMPERATURE_RECRUITMENT=0.2
OLLAMA_TEMPERATURE_CHAT=0.3
OLLAMA_TEMPERATURE_RAG=0.3
OMNIROUTE_URL=http://127.0.0.1:20128/v1
# Optional. Leave blank when OmniRoute is not installed or has no usable quota.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL_NAME=auto
# Keep blank to use local Ollama as OmniRoute's direct messaging fallback.
GROQ_API_KEY=
GROQ_MODEL_NAME=allam-2-7b
GROQ_FALLBACK_ENABLED=false
GITHUB_TOKEN=replace-with-github-models-token-or-leave-blank
GITHUB_TOKEN_2=
GITHUB_TOKEN_3=
GITHUB_MODEL_NAME=openai/gpt-4o-mini
GITHUB_MODEL_ENDPOINT=https://models.github.ai/inference
PRIMARY_AI_PROVIDER=ollama
OLLAMA_MEMORY_DB_URL=
OLLAMA_MEMORY_OWNER_PASSWORD=
FAZLE_AI_READER_DB_URL=
FAZLE_AI_READER_PASSWORD=
KIMI_MODEL_NAME=kimi-k2.6:cloud
NINE_ROUTER_URL=http://127.0.0.1:20129/v1
NINE_ROUTER_PRIVATE_URL=
NINE_ROUTER_DATA_PATH=/home/azim/9router/data/db/data.sqlite
NINE_ROUTER_VERSION=0.5.75
NINE_ROUTER_CREDENTIAL_REF=nine_router_core_api_key
NINE_ROUTER_SINGLE_UPSTREAM_GUARANTEED=false

# ── WhatsApp bridges and external channels ──────────────────────────────────
BRIDGE1_URL=http://127.0.0.1:8082
BRIDGE1_NUMBER=
BRIDGE1_LABEL=HR
BRIDGE2_URL=http://127.0.0.1:8081
BRIDGE2_NUMBER=
BRIDGE2_LABEL=OPS
BRIDGE3_URL=http://127.0.0.1:8083
BRIDGE3_NUMBER=
BRIDGE3_LABEL=REC2
BRIDGE1_DB_PATH=/home/azim/whatsapp1/store/messages.db
BRIDGE1_WHATSAPP_DB_PATH=/home/azim/whatsapp1/store/whatsapp.db
BRIDGE2_DB_PATH=/home/azim/whatsapp2/store/messages.db
BRIDGE2_WHATSAPP_DB_PATH=/home/azim/whatsapp2/store/whatsapp.db
BRIDGE3_DB_PATH=/home/azim/whatsapp3/store/messages.db
BRIDGE3_WHATSAPP_DB_PATH=/home/azim/whatsapp3/store/whatsapp.db
BRIDGE_WEBHOOK_SECRET=replace-with-bridge-webhook-secret-or-leave-blank
WEBHOOK_SIGNATURE_ENFORCEMENT=false
META_WEBHOOK_SIGNATURE_ENFORCEMENT=true
OUTBOUND_ENABLED=false
USE_OUTBOUND_QUEUE=true
OUTBOUND_BRIDGE_TIMEOUT_S=10
BRIDGE_MEDIA_ACQUISITION_ENABLED=false
BRIDGE_MEDIA_DOWNLOAD_TIMEOUT_S=45
META_PHONE_NUMBER_ID=
META_API_TOKEN=
META_API_URL=https://graph.facebook.com/v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# ── Hermes runner ────────────────────────────────────────────────────────────
# These authenticate Core-to-Hermes calls only; they do not create a web login.
HERMES_RUNNER_URL=http://127.0.0.1:8093
HERMES_RUNNER_SECRET=replace-with-admin-hermes-runner-secret-or-leave-blank
HERMES_RUNNER_CUSTOMER_SECRET=replace-with-customer-hermes-secret-or-leave-blank
HERMES_ADMIN_GRANT_TIMEOUT_SECONDS=5
HERMES_ALERT_INVESTIGATION_ENABLED=false
HERMES_ALERT_INVESTIGATION_COOLDOWN_SECONDS=3600
HERMES_DECISION_AUDIT_ENABLED=false
HERMES_EVENT_LOG_ENABLED=false

# ── Optional supporting services ─────────────────────────────────────────────
QDRANT_HOST=
QDRANT_PORT=6333
MEDIA_PROCESSOR_URL=http://127.0.0.1:8090
LOCATIONWHERE_BASE_URL=http://127.0.0.1:3000/api/v1
LOCATIONWHERE_JWT_TOKEN=
LOCATIONWHERE_EMPLOYEE_LOCATION_ENDPOINT=/location/live
LOCATIONWHERE_DEVICE_STATUS_ENDPOINT=/device/{device_id}/status
LOCATIONWHERE_HEALTH_ENDPOINT=/gateway/status
LOCATION_ADAPTER_TIMEOUT_S=2
LOCATION_ADAPTER_RETRIES=2
LOCATION_ADAPTER_CACHE_TTL_S=30
LOCATION_ADAPTER_CIRCUIT_MAX_FAILURES=5
LOCATION_ADAPTER_CIRCUIT_WINDOW_S=120
LOCATION_ADAPTER_CIRCUIT_OPEN_S=60

# ── Identity and authorization ──────────────────────────────────────────────
# ADMIN_NUMBERS bootstraps phone numbers as superadmins; it does not set login
# credentials. Keep empty for a fresh local database.
ADMIN_NUMBERS=
ADMIN_META_NUMBER=
ADMIN_BRIDGE1_NUMBER=
ADMIN_BRIDGE2_NUMBER=
ADMIN_BRIDGE3_NUMBER=
ACCOUNTANT_PHONE=
FPE_CASH_AUTHORIZED_PHONES=
FPE_INCOME_AUTHORIZED_PHONES=
FPE_SYNC_CHAT_JIDS=
ESCORT_CLIENT_PHONES=
ESCORT_TRUSTED_SOURCES=bridge1,bridge2,meta
ESCORT_ORDER_GROUP_JID=

# ── Safe local defaults and feature switches ─────────────────────────────────
AUTO_REPLY_ENABLED=false
RECRUITMENT_AUTOREPLY_ENABLED=false
AUTO_REPLY_SOURCES=bridge1,bridge2,meta
DRAFT_CREATION_ENABLED=true
INTERNAL_NOTIFICATIONS_ENABLED=false
OFFICE_PAYROLL_AUTHORITATIVE_ENABLED=false
AI_CONSOLE_CHAT_ENABLED=false
AI_SAFE_MODE=false
RAG_STARTUP_QDRANT_SYNC_ENABLED=false
HYBRID_SEARCH_ENABLED=false
REVIEWED_REPLY_MEMORY_ENABLED=true
CONVERSATION_MEMORY_ENABLED=false
WHATSAPP_THREAD_RECONSTRUCTION_ENABLED=false
MULTI_MESSAGE_ESCORT_PARSER_ENABLED=false
BANGLA_SEMANTIC_PARSER_ENABLED=false
ROUTE_B_HANDOFF_ENABLED=false
ROUTE_B_ESCORT_HANDOFF_ENABLED=false
RECRUITMENT_POLICY_ESCALATION_ENABLED=false
RECRUITMENT_ANSWER_FIRST_ENABLED=false
RECRUITMENT_FACTCHECK_NORMALIZED=false
RECRUITMENT_STRUCTURED_LOGGING_ENABLED=true
RECRUITMENT_TURN_DECISION_V2_ENABLED=false
RECRUITMENT_TURN_DECISION_V2_REAL_LLM=false
RECRUITMENT_TURN_DECISION_V2_DIRECT_PROVIDER_FALLBACK=false
RECRUITMENT_RESPECT_MANUAL_REPLY=false
RECRUITMENT_ACTOR_PROVENANCE_WRITEBACK=false
UNIFIED_AI_ROUTING_ENABLED=false
UNIFIED_AI_ROUTING_SHADOW_MODE=false
UNIFIED_AI_ROUTING_POLICY_SOURCE=bootstrap
UNIFIED_AI_ROUTING_WORKLOADS=conversational_reply,recruitment_reply,recruitment_decision,simple_intent_classification
SYSTEM_SECRET_MASTER_KEY=
AI_POLICY_RUNNER_BEARER=
AI_POLICY_OBSERVER_BEARER=

# ── Routing, RAG, scheduling, and operational tuning ────────────────────────
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5
RAG_CACHE_TTL=300
EMBEDDING_CACHE_MAX_SIZE=2000
OCR_CONCURRENCY=2
PAYROLL_BULK_CONCURRENCY=1
MESSAGE_MAX_LEN=4096
MESSAGE_ROUTE_TIMEOUT=30
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Dhaka
BACKUP_DIR=/home/azim/backups
BACKUP_SUBDIR=fazle
BACKUP_PG_CONTAINER=ai-postgres
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
FAZLE_LOG_DIR=./logs
APP_VERSION=1.1.0
HEALTH_DISK_WARN_PCT=80
HEALTH_DISK_CRIT_PCT=90
HEALTH_MEM_CRIT_MB=200
HEALTH_CPU_WARN_PCT=80
HEALTH_CPU_CRIT_PCT=95
FRONTEND_SYNC_ENABLED=true
SELF_HEAL_ENABLED=true
QUEUE_ARBITER_ENABLED=true
PAYMENT_RELAY_ENABLED=false
PAYMENT_RELAY_ACCOUNTING_ENABLED=false
FPE_PAYMENT_INACTIVITY_SWEEP_ENABLED=false
AGENT_ADMIN_FORWARD_ENABLED=false
AGENT_PROACTIVE_OUTBOUND_ENABLED=false

