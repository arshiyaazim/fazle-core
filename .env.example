# ──────────────────────────────────────────────────────────────────────────────
# Fazle Core — .env example
#
#   cp .env.example .env && chmod 600 .env
#
# Only DATABASE_URL is mandatory. Every other key below already has a working
# default inside app/config.py; they are listed here because an operator
# usually needs to change them. Anything not listed here can still be set —
# see app/config.py (Settings) for the full list of ~200 keys.
#
# NEVER commit the real .env. It is git-ignored on purpose.
# Keep the safe-mode switches (OUTBOUND_ENABLED / AUTO_REPLY_ENABLED) OFF until
# you have verified everything else — see README §"Operating Mode".
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# PostgreSQL 15+. The app will not start without a live connection: lifespan()
# awaits init_db() before serving.
#   asyncpg DSN form: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://fazle:fazle_local_password@127.0.0.1:5432/fazle_core

# ── APP ───────────────────────────────────────────────────────────────────────
APP_PORT=8200
LOG_LEVEL=INFO
DEBUG=false
# Required by every admin/mutation endpoint (header: X-Internal-Key).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# ── REDIS (optional — in-memory fallback when absent) ─────────────────────────
REDIS_URL=redis://127.0.0.1:6379/9

# ── POSTGRES / MIGRATIONS (only read by db/migrate.py and the Makefile) ───────
# TEST_DATABASE_URL=postgresql://postgres:local_test_password@127.0.0.1:5432/fazle_test
# TEST_DB_PASSWORD=local_test_password

# ── LOCAL AI — OLLAMA (optional) ──────────────────────────────────────────────
# Needed only for local model replies. Install Ollama, then:
#   ollama pull hermes3:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:3b
# When true, Ollama is removed from customer-facing reply generation.
OLLAMA_REPLY_DISABLED=false
OLLAMA_INFER_CONCURRENCY=1

# ── AI GATEWAYS (optional) ────────────────────────────────────────────────────
# OmniRoute — first step of the reply chain (OmniRoute → Groq → Ollama → Kimi).
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL_NAME=auto
# Groq — disabled by default (empty key).
GROQ_API_KEY=
GROQ_MODEL_NAME=allam-2-7b
# Kimi — reached through the same Ollama client (cloud-model proxy).
KIMI_MODEL_NAME=kimi-k2.6:cloud

# ── WHATSAPP BRIDGES (optional — only for real WhatsApp traffic) ──────────────
# Core talks to these HTTP endpoints AND reads their SQLite stores directly.
# The bridge binaries are NOT part of this repository.
BRIDGE1_URL=http://127.0.0.1:8082
BRIDGE1_NUMBER=
BRIDGE2_URL=http://127.0.0.1:8081
BRIDGE2_NUMBER=
BRIDGE3_URL=http://127.0.0.1:8083
BRIDGE3_NUMBER=

# Override these for a local/dev machine — the defaults are the production
# VPS layout (/home/azim/whatsappN/store/...).
# BRIDGE1_DB_PATH=/path/to/whatsapp1/store/messages.db
# BRIDGE1_WHATSAPP_DB_PATH=/path/to/whatsapp1/store/whatsapp.db
# BRIDGE2_DB_PATH=/path/to/whatsapp2/store/messages.db
# BRIDGE2_WHATSAPP_DB_PATH=/path/to/whatsapp2/store/whatsapp.db
# BRIDGE3_DB_PATH=/path/to/whatsapp3/store/messages.db
# BRIDGE3_WHATSAPP_DB_PATH=/path/to/whatsapp3/store/whatsapp.db

# Webhook signature verification. Stay in audit mode (false) until every
# bridge is confirmed to send a valid HMAC.
BRIDGE_WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_ENFORCEMENT=false

# ── META WHATSAPP CLOUD API (optional) ────────────────────────────────────────
META_PHONE_NUMBER_ID=
META_API_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_URL=https://graph.facebook.com/v23.0
META_WEBHOOK_SIGNATURE_ENFORCEMENT=true

# ── HERMES RUNNER (optional — fails closed when unset) ────────────────────────
# Separate service, not vendored here. Two DIFFERENT secrets on purpose:
# the admin grant and the customer-dispatch credential must never be shared.
HERMES_RUNNER_URL=http://127.0.0.1:8093
HERMES_RUNNER_SECRET=
HERMES_RUNNER_CUSTOMER_SECRET=
HERMES_ALERT_INVESTIGATION_ENABLED=false

# ── RBAC / PEOPLE ─────────────────────────────────────────────────────────────
# Comma-separated E.164 numbers without '+' — bootstrap superadmins on startup.
ADMIN_NUMBERS=
ADMIN_BRIDGE1_NUMBER=
ADMIN_BRIDGE2_NUMBER=
ADMIN_BRIDGE3_NUMBER=
ADMIN_META_NUMBER=
ACCOUNTANT_PHONE=
COMPANY_NAME=Al-Rifa'i Integrated Services

# ── RAG (optional) ────────────────────────────────────────────────────────────
# Leave Qdrant unset to use the embedded on-disk store (BM25-only still works).
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
RAG_STARTUP_QDRANT_SYNC_ENABLED=false

# ── OTHER INTEGRATIONS (optional) ─────────────────────────────────────────────
MEDIA_PROCESSOR_URL=http://127.0.0.1:8090
# LOCATIONWHERE_BASE_URL=http://127.0.0.1:3000/api/v1
# LOCATIONWHERE_JWT_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# ── OPERATING MODE — SAFE DEFAULTS, DO NOT FLIP BLINDLY ───────────────────────
# AUTO_REPLY_ENABLED=false  → customer replies are suppressed
# DRAFT_CREATION_ENABLED=true → unsafe/suppressed replies become admin drafts
# OUTBOUND_ENABLED=false    → the outbound worker delivers nothing
AUTO_REPLY_ENABLED=false
RECRUITMENT_AUTOREPLY_ENABLED=false
DRAFT_CREATION_ENABLED=true
INTERNAL_NOTIFICATIONS_ENABLED=true
AUTO_REPLY_SOURCES=bridge1,bridge2,meta
OUTBOUND_ENABLED=false
USE_OUTBOUND_QUEUE=true
SOCIAL_AUTO_REPLY_SINGLE_ENGINE=true

# ── FEATURE FLAGS — all default OFF, opt in deliberately ──────────────────────
AI_SAFE_MODE=false
UNIFIED_AI_ROUTING_ENABLED=false
CONVERSATION_MEMORY_ENABLED=false
ROUTE_B_HANDOFF_ENABLED=false
RECRUITMENT_TURN_DECISION_V2_ENABLED=false
AI_CONSOLE_CHAT_ENABLED=false
